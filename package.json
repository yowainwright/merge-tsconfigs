{
  "name": "merge-tsconfigs",
  "version": "0.2.2",
  "description": "Merge-tsconfigs is a CLI and node tool for merging tsconfig files into the exact tsconfig file you want 🛣️",
  "keywords": [
    "ts",
    "tsconfig",
    "tsconfig-cli",
    "tsconfig-merge",
    "typescript"
  ],
  "homepage": "https://github.com/yowainwright/merge-tsconfigs#readme",
  "bugs": {
    "url": "https://github.com/yowainwright/merge-tsconfigs/issues"
  },
  "license": "MIT",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (https://jeffry.in)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/merge-tsconfigs.git"
  },
  "bin": {
    "merge-tsconfigs": "./dist/program.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup src/program.ts --format esm --dts",
    "clean": "node --eval \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('config', { recursive: true, force: true })\"",
    "cmd:test": "tsx src/program.ts --isTestingCLI",
    "cmd:test:cli": "tsx src/program.ts 'tsconfig.json' --out 'tsconfig.test.json' --outDir 'fooboo' --debug",
    "commit": "git-cz",
    "commit-msg": "sh scripts/commit-msg.sh",
    "deps:check": "codependence && pastoralist --dry-run",
    "deps:update": "codependence --update && pastoralist",
    "format": "oxfmt src tests package.json tsconfig.json .codependencerc .oxlintrc.json .oxfmtrc.json .github/workflows",
    "format:check": "oxfmt --check src tests package.json tsconfig.json .codependencerc .oxlintrc.json .oxfmtrc.json .github/workflows",
    "lint": "oxlint src tests",
    "lint-fix": "oxlint src tests --fix",
    "pack:check": "pnpm build && CI=true pnpm pack --json --pack-destination ./.npm-cache",
    "pre-commit": "lint-staged",
    "prepack": "pnpm build",
    "prepare": "sh scripts/setup.sh",
    "prepublishOnly": "pnpm validate",
    "release": "release-it",
    "release:current": "release-it --no-increment --ci",
    "release:current:dry": "release-it --no-increment --dry-run",
    "release:patch": "release-it patch --ci",
    "release:patch:dry": "release-it patch --dry-run",
    "release:minor": "release-it minor --ci",
    "release:minor:dry": "release-it minor --dry-run",
    "release:major": "release-it major --ci",
    "release:major:dry": "release-it major --dry-run",
    "release:beta": "release-it prepatch --preRelease=beta --ci",
    "release:beta:dry": "release-it prepatch --preRelease=beta --dry-run",
    "release:alpha": "release-it prepatch --preRelease=alpha --ci",
    "release:alpha:dry": "release-it prepatch --preRelease=alpha --dry-run",
    "release:dry": "release-it --dry-run",
    "setup": "sh scripts/setup.sh",
    "setup:config": "mkdir config && cd config npx tsc --init",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "update": "pnpm run deps:update",
    "validate": "pnpm typecheck && pnpm typecheck:tsgo && pnpm format:check && pnpm build && pnpm lint && pnpm test && pnpm pack:check"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260611.2",
    "codependence": "^0.3.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "pastoralist": "^1.12.3",
    "release-it": "^20.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,md}": [
      "oxfmt"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "sh -c 'pnpm run test'"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1",
  "release-it": {
    "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
    "hooks": {
      "before:init": "pnpm validate"
    },
    "git": {
      "requireBranch": "main",
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "commitArgs": [
        "--no-verify"
      ],
      "tagName": "v${version}",
      "tagAnnotation": "Release ${version}",
      "push": true,
      "pushArgs": [
        "--follow-tags"
      ]
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    }
  }
}
