{
  "name": "merge-tsconfigs",
  "version": "0.2.2",
  "description": "Merge-tsconfigs is a CLI and node tool for merging tsconfig files into the exact tsconfig file you want 🛣️",
  "keywords": [
    "ts",
    "tsconfig",
    "tsconfig-cli",
    "tsconfig-merge",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/yowainwright/merge-tsconfigs/issues"
  },
  "license": "MIT",
  "author": "Jeff Wainwright <https:jeffry.in> (yowainwright@gmail.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/merge-tsconfigs.git"
  },
  "bin": {
    "merge-tsconfigs": "./dist/program.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsup src/program.ts --format esm --dts",
    "clean": "node --eval \"fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('config', { recursive: true, force: true })\"",
    "cmd:test": "tsx src/program.ts --isTestingCLI",
    "cmd:test:cli": "tsx src/program.ts 'tsconfig.json' --out 'tsconfig.test.json' --outDir 'fooboo' --debug",
    "commit": "git-cz",
    "commit-msg": "sh scripts/commit-msg.sh",
    "format": "oxfmt src tests package.json tsconfig.json .codependencerc .oxlintrc.json .oxfmtrc.json .github/workflows",
    "format:check": "oxfmt --check src tests package.json tsconfig.json .codependencerc .oxlintrc.json .oxfmtrc.json .github/workflows",
    "lint": "oxlint src tests",
    "lint-fix": "oxlint src tests --fix",
    "pre-commit": "lint-staged",
    "prepare": "sh scripts/setup.sh",
    "prepublishOnly": "pnpm run typecheck && pnpm run format:check && pnpm run lint && pnpm run test && pnpm run build",
    "release": "release-it",
    "setup": "sh scripts/setup.sh",
    "setup:config": "mkdir config && cd config npx tsc --init",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "update": "codependence --update"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "codependence": "^0.3.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "pastoralist": "^1.12.3",
    "release-it": "^20.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,md}": [
      "oxfmt"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "sh -c 'pnpm run test'"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.12.1",
  "release-it": {
    "git": {
      "commitMessage": "chore: release v$npm_package_version"
    }
  }
}
